# Copy this file to .env and fill it in. Never commit .env, never paste keys into a chat.

# =================== LLM providers ===================
# Several keys per provider: separate them with commas, no spaces needed.
NVIDIA_API_KEYS=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

GEMINI_API_KEYS=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

GROQ_API_KEYS=
GROQ_BASE_URL=https://api.groq.com/openai/v1

HF_API_KEYS=
HF_BASE_URL=https://router.huggingface.co/v1

# =================== Model chains ===================
# Tried left to right as provider:model. When one fails (bad key, rate limit, model missing)
# the next one is used automatically.
# STRONG = planner, section writers, assembler.  FAST = Hermes reviewer, claim verifier.
# Confirm each id on the model's page (build.nvidia.com, Google AI Studio, Groq console).
# Replace GEMINI_FLASH_MODEL_ID and GROQ_MODEL_ID with real ids; entries left as
# placeholders are skipped with a warning.
STRONG_CHAIN=nvidia:nvidia/nemotron-3-ultra-550b-a55b,nvidia:deepseek-ai/deepseek-v4-pro,gemini:GEMINI_FLASH_MODEL_ID
FAST_CHAIN=nvidia:nvidia/nemotron-3-super-120b-a12b,nvidia:deepseek-ai/deepseek-v4-flash,gemini:GEMINI_FLASH_MODEL_ID,groq:GROQ_MODEL_ID

# Ask models to skip "thinking" where supported (faster, cleaner JSON). true or false.
DISABLE_THINKING=true
# How many LLM calls may run at the same time (lower it if you hit rate limits).
LLM_MAX_CONCURRENCY=3
# Which runner a run uses: python (default) or langgraph (the same steps as a LangGraph graph, apollo/graph.py).
ORCHESTRATOR=python

# =================== Prices (optional) ===================
# US dollars per million tokens, input (prompt) and output (completion), per provider.
# Used only for the estimated cost shown in the app. Leave empty or 0 for free tiers.
PRICE_IN_NVIDIA=0
PRICE_OUT_NVIDIA=0
PRICE_IN_GEMINI=0
PRICE_OUT_GEMINI=0
PRICE_IN_GROQ=0
PRICE_OUT_GROQ=0
PRICE_IN_HF=0
PRICE_OUT_HF=0

# =================== Search ===================
# https://tavily.com  — several keys allowed, comma-separated
TAVILY_API_KEYS=
# basic = 1 credit per search, advanced = 2 credits (more relevant snippets). Default basic.
SEARCH_DEPTH=basic

# Only for the "edgar" source. SEC requires a name and contact email.
SEC_USER_AGENT=Your Name your.email@example.com
